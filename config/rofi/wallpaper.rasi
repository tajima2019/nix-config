/* ~/.config/rofi/wallpaper.rasi
 * Catppuccin Mocha 風 / 横長(16:9)サムネイル向けグリッド */

* {
    /* カラーパレット */
    base:       #1e1e2eee;
    mantle:     #181825ff;
    crust:      #11111bff;
    surface0:   #313244ff;
    surface1:   #45475aff;
    text:       #cdd6f4ff;
    subtext:    #a6adc8ff;
    accent:     #cba6f7ff;   /* mauve */
    accent-alt: #89b4faff;   /* blue  */
    clear:      transparent;

    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @text;
}

/* ウィンドウ */
window {
    location: center;
    anchor: center;
    width: 70%;
    background-color: @base;
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    padding: 14px;
}

/* 検索バーなし: グリッドのみ(文字入力での絞り込み自体は内部的に動作する) */
mainbox {
    background-color: transparent;
    spacing: 12px;
    children: [ textbox-title, listview ];
}

/* タイトル */
textbox-title {
    str: "󰸉  Wallpaper Selection";
    expand: false;
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 22";
    horizontal-align: 0.5;
    padding: 4px 0px 8px 0px;
}

/* グリッド: 4列 x 3行 = 1ページ12枚 */
listview {
    background-color: transparent;
    columns: 4;
    lines: 3;
    spacing: 12px;
    fixed-columns: true;
    flow: horizontal;
    cycle: true;
    scrollbar: false;
}

/* 1枚ぶんのカード */
element {
    background-color: @mantle;
    text-color: @subtext;
    orientation: vertical;
    children: [ element-icon ];
    spacing: 0px;
    padding: 8px;
    border: 2px;
    border-color: @clear;      /* 選択時に大きさが変わらないよう透明の枠を確保 */
    border-radius: 14px;
}

element alternate.normal,
element normal.normal {
    background-color: @mantle;
}

/* サムネイル */
element-icon {
    size: 7.5em;
    horizontal-align: 0.5;
    background-color: transparent;
}

/* ファイル名(3行を画面に収めるため非表示。出す場合は true に) */
element-text {
    enabled: false;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "sans-serif 9";
}

/* ホバー */
element normal.active,
element alternate.active {
    text-color: @accent-alt;
}

/* 選択中 */
element selected.normal,
element selected.active {
    background-color: @surface0;
    text-color: @text;
    border-color: @accent;
}
